DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/officepet
JWT_SECRET=replace-with-a-long-random-secret

# Optional AI companion. Without a key, the app uses local contextual replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Required for YouTube search and playback results.
YOUTUBE_API_KEY=

# Optional email-based OTP delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
